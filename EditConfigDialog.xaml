<Window x:Class="StudyDemo01.EditConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更改数据库配置" Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        ResizeMode="NoResize">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="数据库连接配置" FontSize="16" FontWeight="SemiBold"
                   Foreground="#1E293B" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <!-- Server -->
            <TextBlock Text="服务器地址" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
            <Border Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Height="34" Margin="0,0,0,10">
                <TextBox x:Name="txtServer" BorderThickness="0" Background="Transparent"
                         FontSize="13" VerticalContentAlignment="Center" Padding="10,0"/>
            </Border>

            <!-- Port -->
            <TextBlock Text="端口" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
            <Border Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Height="34" Margin="0,0,0,10">
                <TextBox x:Name="txtPort" BorderThickness="0" Background="Transparent"
                         FontSize="13" VerticalContentAlignment="Center" Padding="10,0"/>
            </Border>

            <!-- UserId -->
            <TextBlock Text="用户名" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
            <Border Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Height="34" Margin="0,0,0,10">
                <TextBox x:Name="txtUserId" BorderThickness="0" Background="Transparent"
                         FontSize="13" VerticalContentAlignment="Center" Padding="10,0"/>
            </Border>

            <!-- Password -->
            <TextBlock Text="密码" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
            <Border Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Height="34">
                <PasswordBox x:Name="txtPassword" BorderThickness="0" Background="Transparent"
                             FontSize="13" VerticalContentAlignment="Center" Padding="10,0"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="80" Height="34" FontSize="13"
                    Background="#64748B" Foreground="White"
                    BorderThickness="0" Click="BtnCancel_Click"/>
            <Button Content="保存" Width="80" Height="34" Margin="10,0,0,0"
                    FontSize="13" FontWeight="SemiBold"
                    Background="#2563EB" Foreground="White"
                    BorderThickness="0" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>