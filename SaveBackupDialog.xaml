<Window x:Class="StudyDemo01.SaveBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据库备份" Height="220" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="数据库备份" FontSize="14" FontWeight="SemiBold"
                   Foreground="#1E293B" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="备份目录（SQL Server 服务器上的路径）" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>

        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Height="36">
            <TextBox x:Name="txtBackupPath" BorderThickness="0" Background="Transparent"
                     FontSize="12" VerticalContentAlignment="Center" Padding="10,0"
                     Text="D:\Backups"/>
        </Border>

        <TextBlock Grid.Row="3" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0"
                   Text="目录不存在时将自动创建"/>

        <TextBlock x:Name="txtFileName" Grid.Row="4" FontSize="11" Foreground="#F97316"
                   FontWeight="SemiBold" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="70" Height="30" FontSize="12"
                    Background="#64748B" Foreground="White"
                    BorderThickness="0" Click="BtnCancel_Click"/>
            <Button x:Name="btnOk" Content="开始备份" Width="80" Height="30" Margin="10,0,0,0"
                    FontSize="12" FontWeight="SemiBold"
                    Background="#F97316" Foreground="White"
                    BorderThickness="0" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>