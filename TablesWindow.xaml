<Window x:Class="StudyDemo01.TablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表结构" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Background="{StaticResource PrimaryBrush}" Width="4" Height="24"
                    CornerRadius="2" Margin="0,0,12,0"/>
            <TextBlock Text="数据库表列表" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtCount" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="dgTables" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{StaticResource CardBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding RowNum}" Width="60"/>
                <DataGridTextColumn Header="表名" Binding="{Binding TableName}" Width="*"/>
                <DataGridTextColumn Header="行数" Binding="{Binding RowCount}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Width="100" Height="36" FontSize="13"
                    Background="{StaticResource TextSecondaryBrush}" Foreground="White"
                    BorderThickness="0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>