<Window x:Class="StudyDemo01.RestoreGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据库还原指南" Height="580" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Background="#8B5CF6" Width="4" Height="24" CornerRadius="2" Margin="0,0,12,0"/>
            <TextBlock Text="数据库还原指南" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <!-- Step 1: Select .bak file -->
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8">
                            <Run Text="1. "/>
                            <Run Text="选择备份文件" FontWeight="SemiBold"/>
                        </TextBlock>
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="1" Height="32">
                                    <TextBox x:Name="txtBakPath" BorderThickness="0" Background="Transparent"
                                             FontSize="12" VerticalContentAlignment="Center" Padding="8,0"
                                             IsReadOnly="True" Foreground="#475569"/>
                                </Border>
                                <Button Grid.Column="1" Content="浏览..." Width="70" Height="32" Margin="8,0,0,0"
                                        FontSize="12" Background="#8B5CF6" Foreground="White"
                                        BorderThickness="0" Click="BtnBrowse_Click"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="txtBakInfo" FontSize="11" Foreground="#94A3B8" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Step 2: Database name -->
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8">
                            <Run Text="2. "/>
                            <Run Text="确认数据库名称" FontWeight="SemiBold"/>
                        </TextBlock>
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12">
                            <Border Background="White" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="1" Height="32">
                                <TextBox x:Name="txtDbName" BorderThickness="0" Background="Transparent"
                                         FontSize="12" VerticalContentAlignment="Center" Padding="8,0"
                                         Foreground="#475569"/>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Step 3: DATA path -->
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8">
                            <Run Text="3. "/>
                            <Run Text="确认数据文件目录"/>
                            <Run Text="（SQL Server 安装路径下的 DATA 目录）" FontSize="11" Foreground="#94A3B8"/>
                        </TextBlock>
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="1" Height="32">
                                    <TextBox x:Name="txtDataPath" BorderThickness="0" Background="Transparent"
                                             FontSize="12" VerticalContentAlignment="Center" Padding="8,0"
                                             Foreground="#475569"/>
                                </Border>
                                <Button Grid.Column="1" Content="查询" Width="56" Height="32" Margin="8,0,0,0"
                                        FontSize="12" Background="#10B981" Foreground="White"
                                        BorderThickness="0" Click="BtnQueryPath_Click"/>
                            </Grid>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                                           FontFamily="Consolas" VerticalAlignment="Center"
                                           Text="SELECT physical_name FROM sys.master_files WHERE database_id = DB_ID('master')"/>
                                <Button Grid.Column="1" Content="复制" Width="46" Height="24" Margin="8,0,0,0"
                                        FontSize="11" Background="#E2E8F0" Foreground="#475569"
                                        BorderThickness="0" Click="BtnCopyQuery_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Step 4: Generated SQL -->
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,4"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1E293B">
                                <Run Text="4. "/>
                                <Run Text="还原脚本"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Text="在 SSMS 或 Navicat 中执行"/>
                        </StackPanel>
                        <Border Background="#1E293B" CornerRadius="6" Padding="12">
                            <TextBlock x:Name="txtSql" FontFamily="Consolas" FontSize="11"
                                       Foreground="#A5F3FC" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons (fixed at bottom) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="复制脚本" Width="80" Height="32" FontSize="12"
                    Background="#8B5CF6" Foreground="White"
                    BorderThickness="0" Click="BtnCopy_Click"/>
            <Button Content="关闭" Width="70" Height="32" Margin="10,0,0,0"
                    FontSize="12" Background="#64748B" Foreground="White"
                    BorderThickness="0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
