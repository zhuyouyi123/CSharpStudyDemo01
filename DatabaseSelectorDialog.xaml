<Window x:Class="StudyDemo01.DatabaseSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择数据库" Height="350" Width="320"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择要连接的数据库" FontSize="14" FontWeight="SemiBold"
                   Foreground="#1E293B" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <ListBox x:Name="lstDatabases" BorderThickness="0" Background="Transparent"
                     FontSize="13" Margin="4">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <TextBlock x:Name="txtLoading" Grid.Row="2" Text="正在加载数据库列表..."
                   FontSize="12" Foreground="#64748B" Margin="0,8,0,0"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="70" Height="30" FontSize="12"
                    Background="#64748B" Foreground="White"
                    BorderThickness="0" Click="BtnCancel_Click"/>
            <Button x:Name="btnOk" Content="确定" Width="70" Height="30" Margin="10,0,0,0"
                    FontSize="12" FontWeight="SemiBold"
                    Background="#2563EB" Foreground="White"
                    BorderThickness="0" IsEnabled="False"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>