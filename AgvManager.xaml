<Window x:Class="StudyDemo01.AgvManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StudyDemo01"
        Title="AGV管理" Height="650" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Margin="16,20,16,24">
                    <StackPanel>
                        <TextBlock Text="AGV管理" FontSize="18" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtDbName" FontSize="11" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <Button Content="返回首页" Style="{StaticResource NavButton}"
                            Click="BackButton_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Margin="8,0">
                    <RadioButton x:Name="navAgvList" Content="  AGV列表" IsChecked="True"
                                 Style="{StaticResource SidebarMenuItem}"
                                 Click="NavAgvList_Click"/>
                    <RadioButton x:Name="navQueueInfo" Content="  队列信息"
                                 Style="{StaticResource SidebarMenuItem}"
                                 Click="NavQueueInfo_Click"/>
                    <RadioButton x:Name="navTaskManage" Content="  设备监控"
                                 Style="{StaticResource SidebarMenuItem}"
                                 Click="NavDeviceMonitor_Click"/>
                    <RadioButton x:Name="navSettings" Content="  系统设置"
                                 Style="{StaticResource SidebarMenuItem}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource CardBrush}" Height="64"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="32,0">
                    <TextBlock x:Name="txtTitle" Text="AGV列表" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="StatusBadge" Background="{StaticResource SuccessBrush}"
                                CornerRadius="10" Padding="12,5">
                            <TextBlock x:Name="StatusText" Text="已连接" FontSize="12"
                                       Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- AGV List Page -->
            <Grid x:Name="pageAgvList" Grid.Row="1" Margin="24,20" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stats Bar -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="刷新" Width="90" Height="32" FontSize="12"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"
                                BorderThickness="0" Click="BtnRefreshAgv_Click" Margin="0,0,20,0"/>
                        <TextBlock x:Name="txtAgvCount" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Separator VerticalAlignment="Center" Margin="20,0" Width="1" Background="#E2E8F0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#10B981" Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtOnlineCount" Text="在线: 0" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border Background="#EF4444" Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtOfflineCount" Text="离线: 0" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border Background="#F59E0B" Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtAlarmCount" Text="报警: 0" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Cards Grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="agvCardsPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,12,12" Background="White" CornerRadius="12"
                                        BorderBrush="{Binding BorderColor}" BorderThickness="2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header with status color -->
                                        <Border Grid.Row="0" CornerRadius="10,10,0,0" Padding="14,10"
                                                Background="{Binding HeaderColor}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DevId}" FontSize="13"
                                                           Foreground="White" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" Opacity="0.9"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- Content -->
                                        <Grid Grid.Row="1" Margin="14,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Battery -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="电量" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                                <Border Background="{Binding BatteryBg}" CornerRadius="6" Padding="10,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding BatteryIcon}" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14" Foreground="{Binding BatteryColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding BatteryText}" FontSize="14"
                                                                   FontWeight="Bold" Foreground="{Binding BatteryColor}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Status -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                                <TextBlock Text="状态" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                                <Border Background="{Binding StatusBg}" CornerRadius="6" Padding="10,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusDotColor}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="{Binding StatusTextColor}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Speed -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="速度" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SpeedDisplay}" FontSize="15"
                                                           FontWeight="Bold" Foreground="#1E293B"/>
                                            </StackPanel>

                                            <!-- Angle -->
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                                <TextBlock Text="角度" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding AngleDisplay}" FontSize="15"
                                                           FontWeight="Bold" Foreground="#1E293B"/>
                                            </StackPanel>

                                            <!-- X Position -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                                                <TextBlock Text="X 坐标" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding X}" FontSize="13" Foreground="#475569"/>
                                            </StackPanel>

                                            <!-- Y Position -->
                                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                                <TextBlock Text="Y 坐标" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding Y}" FontSize="13" Foreground="#475569"/>
                                            </StackPanel>

                                            <!-- Alarm -->
                                            <Border Grid.Row="3" Grid.ColumnSpan="2" 
                                                    Background="{Binding AlarmBg}" CornerRadius="6" Padding="10,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AlarmIcon}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14" Foreground="{Binding AlarmColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding AlarmText}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{Binding AlarmColor}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Queue Info Page -->
            <Grid x:Name="pageQueueInfo" Grid.Row="1" Margin="24,20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="刷新" Width="80" Height="32" FontSize="12"
                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                            BorderThickness="0" Click="BtnRefreshQueue_Click"/>
                    <TextBlock x:Name="txtRecordCount" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DataGrid x:Name="dgQueueInfo" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                              HeadersVisibility="Column" CanUserAddRows="False"
                              CanUserSortColumns="True" AlternationCount="2"
                              ClipboardCopyMode="IncludeHeader">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="80"/>
                            <DataGridTextColumn Header="GroupID" Binding="{Binding groupid}" Width="100"/>
                            <DataGridTextColumn Header="Stations" Binding="{Binding stations}" Width="*"/>
                            <DataGridTextColumn Header="No01" Binding="{Binding No01}" Width="100"/>
                            <DataGridTextColumn Header="No02" Binding="{Binding No02}" Width="100"/>
                            <DataGridTextColumn Header="No03" Binding="{Binding No03}" Width="100"/>
                            <DataGridTextColumn Header="No04" Binding="{Binding No04}" Width="100"/>
                            <DataGridTextColumn Header="No05" Binding="{Binding No05}" Width="100"/>
                            <DataGridTextColumn Header="No06" Binding="{Binding No06}" Width="100"/>
                            <DataGridTextColumn Header="No07" Binding="{Binding No07}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Device Monitor Page -->
            <local:DeviceMonitor x:Name="pageDeviceMonitor" Grid.Row="1" Margin="24,20" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>