<Window x:Class="StudyDemo01.Function1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="功能1" Height="600" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Logo Area -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel Margin="20,24,20,16">
                        <Border Background="{StaticResource PrimaryBrush}"
                                Width="40" Height="40"
                                CornerRadius="10"
                                HorizontalAlignment="Left">
                            <TextBlock Text="S" FontSize="20" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="功能1" FontSize="18" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,12,0,0"/>
                        <TextBlock Text="演示功能模块" FontSize="12"
                                   Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Divider -->
                <Separator DockPanel.Dock="Top" Background="#334155" Margin="20,0"/>

                <!-- Menu Label -->
                <TextBlock DockPanel.Dock="Top" Text="功能导航" FontSize="11"
                           Foreground="#64748B" FontWeight="SemiBold"
                           Margin="28,16,0,8"/>

                <!-- Menu Items -->
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource SidebarMenuItem}" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="功能概览" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarMenuItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="数据管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarMenuItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="高级设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom: Back Button -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,20">
                    <Button Style="{StaticResource NavButton}" Click="BackButton_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="返回首页" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <DockPanel/>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <DockPanel Grid.Column="1" Margin="0">

            <!-- Top Bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="32,16">
                <DockPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="功能1 - 功能概览" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="查看和管理功能1的相关数据" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Background="{StaticResource SuccessBrush}"
                            CornerRadius="8" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="White" Width="8" Height="8"
                                    CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="运行中" FontSize="13" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
                <StackPanel>

                    <!-- Quick Info Cards -->
                    <UniformGrid Columns="2" Margin="0,0,0,24">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                Margin="0,0,12,0" Padding="24,20"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#EFF6FF" Width="44" Height="44"
                                            CornerRadius="10">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20" Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="状态" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="正常运行" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                Margin="12,0,0,0" Padding="24,20"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#F0FDF4" Width="44" Height="44"
                                            CornerRadius="10">
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20" Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="版本" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="v1.0.0" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Main Content Card -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                            Padding="28,24"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="{StaticResource PrimaryBrush}" Width="4" Height="24"
                                        CornerRadius="2" Margin="0,0,12,0"/>
                                <TextBlock Text="功能介绍" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="这是功能1的详细界面。您可以在此模块中执行相关操作。"
                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="24"/>
                            <TextBlock Text="当前模块提供了完整的数据处理能力，支持查看、编辑和管理功能。"
                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="24" Margin="0,8,0,0"/>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,20"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#EFF6FF" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="数据已同步" FontSize="12"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0FDF4" CornerRadius="8" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="所有服务正常" FontSize="12"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>