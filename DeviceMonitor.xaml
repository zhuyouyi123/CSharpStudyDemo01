<UserControl x:Class="StudyDemo01.DeviceMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="0">
        <Border Background="White" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <Grid x:Name="mapContainer">
                <Canvas x:Name="mapCanvas" Background="#F8FAFC"/>

                <!-- Zoom Controls -->
                <StackPanel x:Name="zoomPanel" Panel.ZIndex="90" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" Margin="0,0,12,12">
                    <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0"
                            BorderThickness="1" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Button Content="+" FontSize="18" FontWeight="Bold" Width="36" Height="36"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="#475569" Click="BtnZoomIn_Click"/>
                            <Border Height="1" Background="#E2E8F0"/>
                            <Button Content="-" FontSize="18" FontWeight="Bold" Width="36" Height="36"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="#475569" Click="BtnZoomOut_Click"/>
                            <Border Height="1" Background="#E2E8F0"/>
                            <Button Content="&#x21BB;" FontSize="14" Width="36" Height="36"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="#475569" Click="BtnResetView_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="txtZoom" Panel.ZIndex="90" HorizontalAlignment="Left"
                           VerticalAlignment="Bottom" Margin="12,0,0,14" FontSize="11"
                           Foreground="#94A3B8" Background="#F8FAFC" Padding="6,2"/>

                <!-- Fence Toggle Card -->
                <Border x:Name="fenceToggleCard" Panel.ZIndex="90" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="12,12,0,0" Background="White"
                        CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="10,6,12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="显示围栏" FontSize="12" Foreground="#475569"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border x:Name="toggleShowFences" Width="36" Height="20" CornerRadius="10"
                                Background="#CBD5E1" Cursor="Hand"
                                MouseLeftButtonDown="ToggleShowFences_Click">
                            <Border x:Name="toggleShowFencesThumb" Width="16" Height="16"
                                    CornerRadius="8" Background="White" HorizontalAlignment="Left"
                                    Margin="2,0,0,0"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="updateTimeBorder" Panel.ZIndex="90" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,12,12,0" Background="#EEF2FF"
                        CornerRadius="4" Padding="8,3">
                    <TextBlock x:Name="txtUpdateTime" FontSize="11" FontWeight="SemiBold" Foreground="#4338CA"/>
                </Border>

                <!-- Left-Bottom Info Panel -->
                <Border x:Name="infoPanel" Visibility="Collapsed" Panel.ZIndex="95"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="12,0,0,12" Background="White" CornerRadius="6"
                        BorderBrush="#E2E8F0" BorderThickness="1" MinWidth="350" MaxWidth="350"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- Header -->
                        <Border x:Name="infoHeader" CornerRadius="6,6,0,0" Padding="10,5">
                            <DockPanel>
                                <TextBlock x:Name="infoTitle" FontSize="11" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                                <Button Content="&#x2715;" FontSize="8" Foreground="#FFFFFFBB"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Padding="3,1" Click="BtnCloseInfo_Click"/>
                            </DockPanel>
                        </Border>
                        <!-- Body: Left-Right Layout -->
                        <Grid Margin="10,6,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Left: Basic Info -->
                            <TextBlock x:Name="infoLeftContent" Grid.Column="0"
                                       TextWrapping="Wrap" FontSize="10"
                                       Foreground="#334155" LineHeight="16"/>
                            <!-- Divider -->
                            <Border Grid.Column="1" Width="1" Background="#E2E8F0" Margin="8,0"/>
                            <!-- Right: Task Info -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="执行任务" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#94A3B8" Margin="0,0,0,3"/>
                                <TextBlock x:Name="infoRightContent"
                                           TextWrapping="Wrap" FontSize="10"
                                           Foreground="#334155" LineHeight="15"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
