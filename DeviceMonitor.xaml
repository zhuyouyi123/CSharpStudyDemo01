<UserControl x:Class="StudyDemo01.DeviceMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stats Bar -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Content="刷新" Width="90" Height="32" FontSize="12"
                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                        BorderThickness="0" Click="BtnRefresh_Click" Margin="0,0,20,0"/>
                <TextBlock x:Name="txtMapInfo" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Separator VerticalAlignment="Center" Margin="20,0" Width="1" Background="#E2E8F0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtOnlineMap" Text="在线: 0" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Background="#EF4444" Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtOfflineMap" Text="离线: 0" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Background="#F59E0B" Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtAlarmMap" Text="报警: 0" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Map Area -->
        <Border Grid.Row="1" Background="White" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <Grid x:Name="mapContainer">
                <Canvas x:Name="mapCanvas" Background="#F8FAFC"/>

                <!-- Click Info Card -->
                <Border x:Name="agvInfoCard" Visibility="Collapsed"
                        Background="White" CornerRadius="12" Padding="0"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        Panel.ZIndex="100" MinWidth="260"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- Card Header -->
                        <Border x:Name="cardHeader" CornerRadius="12,12,0,0" Padding="16,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Border x:Name="statusDot" Width="10" Height="10" CornerRadius="5"
                                            Background="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="tipName" FontSize="16" FontWeight="Bold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="btnCloseCard" Content="&#x2715;" FontSize="12"
                                        Foreground="White" Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="BtnCloseCard_Click"/>
                            </DockPanel>
                        </Border>

                        <!-- Card Body -->
                        <StackPanel Margin="16,12,16,16">
                            <!-- Row 1: 电量 & 状态 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="电量" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <Border Background="#F0FDF4" CornerRadius="6" Padding="10,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="tipBattery" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="状态" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <Border x:Name="statusBg" Background="#F0FDF4" CornerRadius="6" Padding="10,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="statusEllipse" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="tipStatus" FontSize="13" FontWeight="SemiBold" Foreground="#10B981"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: 速度 & 角度 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="速度" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tipSpeed" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="角度" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tipAngle" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: 坐标 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X 坐标" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tipX" FontSize="13" Foreground="#475569"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Y 坐标" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tipY" FontSize="13" Foreground="#475569"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
