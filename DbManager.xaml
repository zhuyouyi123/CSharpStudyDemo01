<Window x:Class="StudyDemo01.DbManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据库管理" Height="600" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel Margin="20,24,20,16">
                        <Border Background="{StaticResource PrimaryBrush}"
                                Width="40" Height="40" CornerRadius="10" HorizontalAlignment="Left">
                            <TextBlock Text="D" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="数据库管理" FontSize="18" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,12,0,0"/>
                        <TextBlock Text="连接管理与数据操作" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Separator DockPanel.Dock="Top" Background="#334155" Margin="20,0"/>
                <TextBlock DockPanel.Dock="Top" Text="功能导航" FontSize="11"
                           Foreground="#64748B" FontWeight="SemiBold" Margin="28,16,0,8"/>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource SidebarMenuItem}" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="连接管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,20">
                    <Button Style="{StaticResource NavButton}" Click="BackButton_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="返回首页" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
                <DockPanel/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,16">
                <DockPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="数据库管理" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="连接管理与数据操作" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border x:Name="StatusBadge" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Background="{StaticResource DangerBrush}" CornerRadius="8" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="White" Width="8" Height="8"
                                    CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="未连接" FontSize="13" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
                <StackPanel>
                    <!-- 连接操作 -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                            Padding="28,24" Margin="0,0,0,20"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="{StaticResource WarningBrush}" Width="4" Height="24"
                                        CornerRadius="2" Margin="0,0,12,0"/>
                                <TextBlock Text="连接操作" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnConnect" Content="连接数据库" Height="44"
                                        Margin="0,0,6,0" FontSize="14" FontWeight="SemiBold"
                                        Background="{StaticResource SuccessBrush}" Foreground="White"
                                        BorderThickness="0" Grid.Column="0" Click="BtnConnect_Click"/>
                                <Button x:Name="btnDisconnect" Content="断开连接" Height="44"
                                        Margin="6,0,6,0" FontSize="14" FontWeight="SemiBold"
                                        Background="{StaticResource DangerBrush}" Foreground="White"
                                        BorderThickness="0" IsEnabled="False" Grid.Column="1" Click="BtnDisconnect_Click"/>
                                <Button x:Name="btnRefresh" Content="更改配置" Height="44"
                                        Margin="6,0,0,0" FontSize="14" FontWeight="SemiBold"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                                        BorderThickness="0" Grid.Column="2" Click="BtnChangeConfig_Click"/>
                            </Grid>
                            <Border x:Name="SuccessBorder" Background="#F0FDF4" CornerRadius="8"
                                    Padding="14,10" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{StaticResource SuccessBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="SuccessText" FontSize="13"
                                               Foreground="{StaticResource SuccessBrush}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ErrorBorder" Background="#FEF2F2" CornerRadius="8"
                                    Padding="14,10" Margin="0,8,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="ErrorTitle" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="#FFFFFF" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                        <TextBlock x:Name="ErrorDetail" FontSize="12"
                                                   Foreground="#7F1D1D" TextWrapping="Wrap"
                                                   FontFamily="Consolas" LineHeight="20"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 数据操作 -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                            Padding="28,24"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="{StaticResource PrimaryBrush}" Width="4" Height="24"
                                        CornerRadius="2" Margin="0,0,12,0"/>
                                <TextBlock Text="数据操作" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnShowTables" Content="查看表结构" Height="60"
                                        FontSize="14" FontWeight="SemiBold" IsEnabled="False"
                                        Background="#EFF6FF" Foreground="{StaticResource PrimaryBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                                        Grid.Column="0" Click="BtnShowTables_Click" Margin="0,0,6,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="22" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0" Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnExecSql" Content="执行SQL" Height="60"
                                        FontSize="14" FontWeight="SemiBold" IsEnabled="False"
                                        Background="#F0FDF4" Foreground="#10B981"
                                        BorderBrush="#10B981" BorderThickness="1"
                                        Grid.Column="1" Click="BtnExecSql_Click" Margin="6,0,6,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="22" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource SuccessBrush}"/>
                                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0" Foreground="{StaticResource SuccessBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#DCFCE7"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnBackup" Content="数据备份" Height="60"
                                        FontSize="14" FontWeight="SemiBold" IsEnabled="False"
                                        Background="#FFF7ED" Foreground="#F97316"
                                        BorderBrush="#F97316" BorderThickness="1"
                                        Grid.Column="2" Click="BtnBackup_Click" Margin="6,0,6,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="22" HorizontalAlignment="Center"
                                                               Foreground="#F97316"/>
                                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0" Foreground="#F97316"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFEDD5"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnRestoreGuide" Content="数据还原" Height="60"
                                        FontSize="14" FontWeight="SemiBold"
                                        Background="#F5F3FF" Foreground="#8B5CF6"
                                        BorderBrush="#8B5CF6" BorderThickness="1"
                                        Grid.Column="3" Click="BtnRestoreGuide_Click" Margin="6,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="22" HorizontalAlignment="Center"
                                                               Foreground="#8B5CF6"/>
                                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0" Foreground="#8B5CF6"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#EDE9FE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="txtHint" Text="请先连接数据库后再使用数据操作功能"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Loading Overlay -->
        <Border x:Name="loadingOverlay" Grid.ColumnSpan="2" Background="#80000000"
                Visibility="Collapsed" IsHitTestVisible="True">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="16" Padding="40,32" MinWidth="320">
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar x:Name="progressBackup" Width="280" Height="8"
                                     IsIndeterminate="True" Foreground="#F97316" Background="#FED7AA"
                                     Margin="0,0,0,20"/>
                        <TextBlock x:Name="txtLoadingStatus" Text="正在备份数据库..."
                                   FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="txtLoadingDetail" Text="请勿关闭窗口..."
                                   FontSize="13" Foreground="#94A3B8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>