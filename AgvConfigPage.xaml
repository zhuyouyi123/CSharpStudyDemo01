<UserControl x:Class="StudyDemo01.AgvConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="White" Padding="32,20">
            <TextBlock Text="AGV功能配置" FontSize="20" FontWeight="SemiBold"
                       Foreground="#1E293B"/>
        </Border>

        <!-- Config Area -->
        <Border Grid.Row="1" Background="White" CornerRadius="12"
                Margin="24,20" Padding="24,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Section: 地图监控 -->
                    <TextBlock Text="地图监控" FontSize="13" FontWeight="SemiBold"
                               Foreground="#64748B" Margin="0,0,0,12"/>

                    <!-- 刷新间隔 -->
                    <Border Background="Transparent" Padding="0,14" BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="数据刷新间隔" FontSize="14" Foreground="#1E293B"/>
                                <TextBlock Text="设备监控地图的自动刷新频率" FontSize="12"
                                           Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="2,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="txtRefreshInterval" Width="48" FontSize="14"
                                                 FontWeight="SemiBold" Foreground="#1E293B"
                                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                                 BorderThickness="0" Background="Transparent"
                                                 MaxLength="3"/>
                                        <TextBlock Text="秒" FontSize="12" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="4,0,8,0"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="保存" Width="56" Height="28" FontSize="12"
                                        FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                        Margin="8,0,0,0" Click="BtnSaveRefresh_Click">
                                    <Button.Background>
                                        <SolidColorBrush Color="#3B82F6"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Section: AGV颜色 -->
                    <TextBlock Text="AGV颜色" FontSize="13" FontWeight="SemiBold"
                               Foreground="#64748B" Margin="0,24,0,12"/>

                    <!-- 在线颜色 -->
                    <Border Background="Transparent" Padding="0,14" BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="在线" FontSize="14" Foreground="#1E293B"/>
                                <TextBlock Text="AGV在线状态显示颜色" FontSize="12"
                                           Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Grid>
                                    <Border x:Name="borderOnColorPreview" Width="28" Height="28"
                                            CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="OnColorPreview_Click"
                                            Tag="txtOnColor"/>
                                    <Popup x:Name="popupOnColor" StaysOpen="True" PlacementTarget="{Binding ElementName=borderOnColorPreview}"
                                           Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" CornerRadius="8" Padding="8"
                                                BorderBrush="#E2E8F0" BorderThickness="1"
                                                PreviewMouseLeftButtonDown="PopupBorder_PreviewMouseDown">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" Opacity="0.15" ShadowDepth="2"/>
                                            </Border.Effect>
                                            <UniformGrid Columns="6" Width="192">
                                                <Border Background="#10B981" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#10B981"/>
                                                <Border Background="#3B82F6" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#3B82F6"/>
                                                <Border Background="#8B5CF6" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#8B5CF6"/>
                                                <Border Background="#EC4899" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#EC4899"/>
                                                <Border Background="#F59E0B" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#F59E0B"/>
                                                <Border Background="#06B6D4" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#06B6D4"/>
                                            </UniformGrid>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBox x:Name="txtOnColor" Width="80" FontSize="13"
                                         VerticalContentAlignment="Center" TextAlignment="Center"
                                         Margin="8,0,0,0" MaxLength="7"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 离线颜色 -->
                    <Border Background="Transparent" Padding="0,14" BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="离线" FontSize="14" Foreground="#1E293B"/>
                                <TextBlock Text="AGV离线状态显示颜色" FontSize="12"
                                           Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Grid>
                                    <Border x:Name="borderOffColorPreview" Width="28" Height="28"
                                            CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="OnColorPreview_Click"
                                            Tag="txtOffColor"/>
                                    <Popup x:Name="popupOffColor" StaysOpen="True" PlacementTarget="{Binding ElementName=borderOffColorPreview}"
                                           Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" CornerRadius="8" Padding="8"
                                                BorderBrush="#E2E8F0" BorderThickness="1"
                                                PreviewMouseLeftButtonDown="PopupBorder_PreviewMouseDown">
                                            <UniformGrid Columns="6" Width="192">
                                                <Border Background="#94A3B8" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#94A3B8"/>
                                                <Border Background="#6B7280" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#6B7280"/>
                                                <Border Background="#374151" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#374151"/>
                                                <Border Background="#1F2937" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#1F2937"/>
                                                <Border Background="#D1D5DB" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#D1D5DB"/>
                                                <Border Background="#E5E7EB" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#E5E7EB"/>
                                            </UniformGrid>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBox x:Name="txtOffColor" Width="80" FontSize="13"
                                         VerticalContentAlignment="Center" TextAlignment="Center"
                                         Margin="8,0,0,0" MaxLength="7"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 报警颜色 -->
                    <Border Background="Transparent" Padding="0,14" BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="报警" FontSize="14" Foreground="#1E293B"/>
                                <TextBlock Text="AGV报警状态显示颜色" FontSize="12"
                                           Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Grid>
                                    <Border x:Name="borderAlarmColorPreview" Width="28" Height="28"
                                            CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="OnColorPreview_Click"
                                            Tag="txtAlarmColor"/>
                                    <Popup x:Name="popupAlarmColor" StaysOpen="True" PlacementTarget="{Binding ElementName=borderAlarmColorPreview}"
                                           Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" CornerRadius="8" Padding="8"
                                                BorderBrush="#E2E8F0" BorderThickness="1"
                                                PreviewMouseLeftButtonDown="PopupBorder_PreviewMouseDown">
                                            <UniformGrid Columns="6" Width="192">
                                                <Border Background="#EF4444" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#EF4444"/>
                                                <Border Background="#F97316" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#F97316"/>
                                                <Border Background="#F59E0B" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#F59E0B"/>
                                                <Border Background="#DC2626" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#DC2626"/>
                                                <Border Background="#B91C1C" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#B91C1C"/>
                                                <Border Background="#FBBF24" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#FBBF24"/>
                                            </UniformGrid>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBox x:Name="txtAlarmColor" Width="80" FontSize="13"
                                         VerticalContentAlignment="Center" TextAlignment="Center"
                                         Margin="8,0,0,0" MaxLength="7"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 颜色保存按钮 -->
                    <Border Background="Transparent" Padding="0,16">
                        <DockPanel>
                            <TextBlock Text="修改后请保存以生效" FontSize="12" Foreground="#94A3B8"
                                       VerticalAlignment="Center"/>
                            <Button Content="保存" Width="72" Height="32" FontSize="13"
                                    FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                    HorizontalAlignment="Right" Click="BtnSaveColors_Click">
                                <Button.Background>
                                    <SolidColorBrush Color="#3B82F6"/>
                                </Button.Background>
                            </Button>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
