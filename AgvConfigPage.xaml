<UserControl x:Class="StudyDemo01.AgvConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
             Loaded="AgvConfigPage_Loaded">
    <Grid Background="Transparent" Margin="24,12"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,14"
                BorderBrush="#E2E8F0" BorderThickness="1"
                VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- ========== 显示设置 ========== -->
                    <TextBlock Text="显示设置" FontSize="15" FontWeight="SemiBold"
                               Foreground="#1E293B" Margin="0,6,0,4"/>

                    <!-- 数据刷新间隔 -->
                    <Border Padding="0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="数据刷新间隔" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="设备监控地图的自动刷新频率" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="2,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="txtRefreshInterval" Width="44" FontSize="13"
                                                 FontWeight="SemiBold" Foreground="#1E293B"
                                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                                 BorderThickness="0" Background="Transparent" MaxLength="3"/>
                                        <TextBlock Text="秒" FontSize="11" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="保存" Width="52" Height="26" FontSize="11"
                                        FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                        Margin="8,0,0,0" Click="BtnSaveRefreshV2_Click">
                                    <Button.Background><SolidColorBrush Color="#3B82F6"/></Button.Background>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- AGV图标大小 -->
                    <Border Padding="0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="AGV图标大小" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="设备监控地图中AGV图标的显示尺寸" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="2,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="txtIconSize" Width="44" FontSize="13"
                                                 FontWeight="SemiBold" Foreground="#1E293B"
                                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                                 BorderThickness="0" Background="Transparent" MaxLength="3"/>
                                        <TextBlock Text="px" FontSize="11" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="保存" Width="52" Height="26" FontSize="11"
                                        FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                        Margin="8,0,0,0" Click="BtnSaveIconSize_Click">
                                    <Button.Background><SolidColorBrush Color="#3B82F6"/></Button.Background>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 角度偏移量 -->
                    <Border Padding="0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="角度偏移量" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="设备图标显示角度的补偿偏移（度）" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="2,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="txtAngleOffset" Width="44" FontSize="13"
                                                 FontWeight="SemiBold" Foreground="#1E293B"
                                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                                 BorderThickness="0" Background="Transparent" MaxLength="4"/>
                                        <TextBlock Text="°" FontSize="11" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="保存" Width="52" Height="26" FontSize="11"
                                        FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                        Margin="8,0,0,0" Click="BtnSaveAngleOffset_Click">
                                    <Button.Background><SolidColorBrush Color="#3B82F6"/></Button.Background>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 显示无连线站点 -->
                    <Border Padding="0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="显示无连线站点" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="关闭后设备监控地图隐藏无连线的站点" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="toggleUnlinked" Width="40" Height="22" CornerRadius="11"
                                        Background="#3B82F6" Cursor="Hand" Margin="0,0,8,0"
                                        MouseLeftButtonDown="ToggleUnlinked_Click">
                                    <Border x:Name="toggleUnlinkedThumb" Width="16" Height="16"
                                            CornerRadius="8" Background="White" HorizontalAlignment="Right" Margin="0,0,3,0"/>
                                </Border>
                                <Button Content="保存" Width="52" Height="26" FontSize="11"
                                        FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                        Click="BtnSaveUnlinked_Click">
                                    <Button.Background><SolidColorBrush Color="#3B82F6"/></Button.Background>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 显示站点标题 -->
                    <Border Padding="0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="显示站点标题" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="关闭后设备监控地图隐藏站点编号文字" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="toggleStationTitle" Width="40" Height="22" CornerRadius="11"
                                        Background="#3B82F6" Cursor="Hand" Margin="0,0,8,0"
                                        MouseLeftButtonDown="ToggleStationTitle_Click">
                                    <Border x:Name="toggleStationTitleThumb" Width="16" Height="16"
                                            CornerRadius="8" Background="White" HorizontalAlignment="Right" Margin="0,0,3,0"/>
                                </Border>
                                <Button Content="保存" Width="52" Height="26" FontSize="11"
                                        FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                        Click="BtnSaveStationTitle_Click">
                                    <Button.Background><SolidColorBrush Color="#3B82F6"/></Button.Background>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ========== 设备颜色 ========== -->
                    <TextBlock Text="设备颜色" FontSize="15" FontWeight="SemiBold"
                               Foreground="#1E293B" Margin="0,16,0,4"/>

                    <!-- 在线颜色 -->
                    <Border Padding="0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="在线颜色" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="AGV在线状态显示颜色" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Grid>
                                    <Border x:Name="borderOnColorPreview" Width="24" Height="24"
                                            CornerRadius="5" BorderBrush="#E2E8F0" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="OnColorPreview_Click" Tag="txtOnColor"/>
                                    <Popup x:Name="popupOnColor" StaysOpen="True"
                                           PlacementTarget="{Binding ElementName=borderOnColorPreview}"
                                           Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" CornerRadius="8" Padding="8"
                                                BorderBrush="#E2E8F0" BorderThickness="1"
                                                PreviewMouseLeftButtonDown="PopupBorder_PreviewMouseDown">
                                            <Border.Effect><DropShadowEffect BlurRadius="8" Opacity="0.15" ShadowDepth="2"/></Border.Effect>
                                            <UniformGrid Columns="6" Width="192">
                                                <Border Background="#10B981" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#10B981"/>
                                                <Border Background="#3B82F6" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#3B82F6"/>
                                                <Border Background="#8B5CF6" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#8B5CF6"/>
                                                <Border Background="#EC4899" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#EC4899"/>
                                                <Border Background="#F59E0B" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#F59E0B"/>
                                                <Border Background="#06B6D4" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="On:#06B6D4"/>
                                            </UniformGrid>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBox x:Name="txtOnColor" Width="72" FontSize="12"
                                         VerticalContentAlignment="Center" TextAlignment="Center"
                                         Margin="6,0,0,0" MaxLength="7"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 离线颜色 -->
                    <Border Padding="0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="离线颜色" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="AGV离线状态显示颜色" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Grid>
                                    <Border x:Name="borderOffColorPreview" Width="24" Height="24"
                                            CornerRadius="5" BorderBrush="#E2E8F0" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="OnColorPreview_Click" Tag="txtOffColor"/>
                                    <Popup x:Name="popupOffColor" StaysOpen="True"
                                           PlacementTarget="{Binding ElementName=borderOffColorPreview}"
                                           Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" CornerRadius="8" Padding="8"
                                                BorderBrush="#E2E8F0" BorderThickness="1"
                                                PreviewMouseLeftButtonDown="PopupBorder_PreviewMouseDown">
                                            <UniformGrid Columns="6" Width="192">
                                                <Border Background="#94A3B8" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#94A3B8"/>
                                                <Border Background="#6B7280" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#6B7280"/>
                                                <Border Background="#374151" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#374151"/>
                                                <Border Background="#1F2937" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#1F2937"/>
                                                <Border Background="#D1D5DB" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#D1D5DB"/>
                                                <Border Background="#E5E7EB" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Off:#E5E7EB"/>
                                            </UniformGrid>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBox x:Name="txtOffColor" Width="72" FontSize="12"
                                         VerticalContentAlignment="Center" TextAlignment="Center"
                                         Margin="6,0,0,0" MaxLength="7"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 报警颜色 -->
                    <Border Padding="0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="报警颜色" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="AGV报警状态显示颜色" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Grid>
                                    <Border x:Name="borderAlarmColorPreview" Width="24" Height="24"
                                            CornerRadius="5" BorderBrush="#E2E8F0" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="OnColorPreview_Click" Tag="txtAlarmColor"/>
                                    <Popup x:Name="popupAlarmColor" StaysOpen="True"
                                           PlacementTarget="{Binding ElementName=borderAlarmColorPreview}"
                                           Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" CornerRadius="8" Padding="8"
                                                BorderBrush="#E2E8F0" BorderThickness="1"
                                                PreviewMouseLeftButtonDown="PopupBorder_PreviewMouseDown">
                                            <UniformGrid Columns="6" Width="192">
                                                <Border Background="#EF4444" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#EF4444"/>
                                                <Border Background="#F97316" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#F97316"/>
                                                <Border Background="#F59E0B" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#F59E0B"/>
                                                <Border Background="#DC2626" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#DC2626"/>
                                                <Border Background="#B91C1C" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#B91C1C"/>
                                                <Border Background="#FBBF24" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" Tag="Alarm:#FBBF24"/>
                                            </UniformGrid>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBox x:Name="txtAlarmColor" Width="72" FontSize="12"
                                         VerticalContentAlignment="Center" TextAlignment="Center"
                                         Margin="6,0,0,0" MaxLength="7"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 保存颜色 -->
                    <Border Padding="0,12">
                        <DockPanel>
                            <TextBlock Text="修改颜色后点击保存生效" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Button Content="保存颜色" Width="68" Height="30" FontSize="12"
                                    FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                    HorizontalAlignment="Right" Click="BtnSaveColorsV2_Click">
                                <Button.Background><SolidColorBrush Color="#3B82F6"/></Button.Background>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- ========== 围栏配置 ========== -->
                    <TextBlock Text="围栏配置" FontSize="15" FontWeight="SemiBold"
                               Foreground="#1E293B" Margin="0,16,0,4"/>

                    <!-- 围栏类型管理 -->
                    <Border Padding="0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="围栏类型" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="管理围栏地图中可选的围栏类型" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Content="添加" Width="52" Height="26" FontSize="11"
                                        FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                        HorizontalAlignment="Right" Click="BtnAddFenceType_Click">
                                    <Button.Background><SolidColorBrush Color="#10B981"/></Button.Background>
                                </Button>
                            </DockPanel>
                            <StackPanel x:Name="fenceTypeListPanel" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Add Fence Type Popup -->
        <Popup x:Name="popupAddFenceType" IsOpen="False" Panel.ZIndex="100"
               AllowsTransparency="True" Placement="Center" StaysOpen="True">
            <Border Background="White" CornerRadius="10" Padding="20"
                    BorderBrush="#E2E8F0" BorderThickness="1" MinWidth="300"
                    PreviewMouseLeftButtonDown="PopupBorder_PreviewMouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Opacity="0.12" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel KeyDown="PopupAddFenceType_KeyDown">
                    <TextBlock Text="添加围栏类型" FontSize="15" FontWeight="SemiBold"
                               Foreground="#1E293B" Margin="0,0,0,12"/>

                    <TextBlock Text="类型名称" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <Border CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1"
                            Background="#F8FAFC" Padding="2,2">
                        <TextBox x:Name="txtNewFenceTypeName" BorderThickness="0"
                                 Padding="8,8" FontSize="13" Background="Transparent"
                                 MaxLength="20"/>
                    </Border>

                    <TextBlock Text="颜色" FontSize="12" Foreground="#64748B" Margin="0,10,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="borderNewFenceTypeColor" Width="32" Height="32"
                                CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1"
                                Background="#3B82F6" Cursor="Hand" Margin="0,0,8,0"/>
                        <UniformGrid Columns="7" Width="252">
                            <Border Background="#EF4444" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#EF4444"/>
                            <Border Background="#F97316" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#F97316"/>
                            <Border Background="#F59E0B" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#F59E0B"/>
                            <Border Background="#10B981" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#10B981"/>
                            <Border Background="#3B82F6" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#3B82F6"/>
                            <Border Background="#8B5CF6" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#8B5CF6"/>
                            <Border Background="#EC4899" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#EC4899"/>
                            <Border Background="#6366F1" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#6366F1"/>
                            <Border Background="#06B6D4" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#06B6D4"/>
                            <Border Background="#14B8A6" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#14B8A6"/>
                            <Border Background="#84CC16" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#84CC16"/>
                            <Border Background="#94A3B8" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#94A3B8"/>
                            <Border Background="#6B7280" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#6B7280"/>
                            <Border Background="#374151" Width="24" Height="24" CornerRadius="4" Margin="2" Cursor="Hand" MouseLeftButtonDown="NewFenceTypeColor_Click" Tag="#374151"/>
                        </UniformGrid>
                    </StackPanel>

                    <TextBlock x:Name="txtFenceTypeError" Text="" FontSize="11"
                               Foreground="#EF4444" Margin="0,8,0,0" MinHeight="16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="取消" Width="60" Height="30" FontSize="12"
                                Foreground="#64748B" Background="White" BorderBrush="#E2E8F0"
                                BorderThickness="1" Cursor="Hand" Margin="0,0,8,0"
                                Click="BtnAddFenceTypeCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="White" BorderBrush="#E2E8F0"
                                            BorderThickness="1" CornerRadius="6" Padding="12,0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="确认" Width="60" Height="30" FontSize="12"
                                FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="BtnAddFenceTypeOk_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#10B981" CornerRadius="6"
                                            Padding="12,0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background">
                                                <Setter.Value><SolidColorBrush Color="#059669"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Tips Toast -->
        <Border x:Name="tipsToast" Panel.ZIndex="200" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,20,0,0" Visibility="Collapsed"
                Background="#10B981" CornerRadius="8" Padding="16,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.2" ShadowDepth="3"/>
            </Border.Effect>
            <TextBlock x:Name="tipsText" Text="" FontSize="13" FontWeight="SemiBold"
                       Foreground="White"/>
        </Border>
    </Grid>
</UserControl>
